# Ambiente
NODE_ENV=development

# MongoDB Atlas Local (docker compose up -d mongo, porta 37017). Os testes usam o banco
# `<banco>_test` deste mesmo servidor, derivado daqui (RUN_BOOK.md#banco-de-dados).
MONGODB_URI=mongodb://localhost:37017/ethica?directConnection=true

# api
API_PORT=18080
SESSION_JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:15173

# Datajud — API Pública do CNJ (prospecção de nomeações). A chave pública vigente
# está na documentação oficial: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# PDF (AD-119) — Chromium do sistema; no docker já é este caminho.
CHROMIUM_PATH=/usr/bin/chromium

# Arquivos do tenant (AD-120) — RustFS (S3) do docker compose (porta 19000). No container da api o
# endpoint é sobrescrito para http://s3:9000. Sem S3_BUCKET o envio de logo fica desligado.
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=ethica
S3_ACCESS_KEY_ID=ethica
S3_SECRET_ACCESS_KEY=ethica-dev-secret
# Só produção (AD-202): papel assumido por escritório. Vazio em dev (o RustFS não assume papel).
S3_ROLE_ARN=

# Mapa de campo (AD-131) — Nominatim público (1 req/s, User-Agent próprio). Troque por um
# serviço próprio ou pago quando houver volume.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=Ethica/1.0 (gestao de pericias)

# Assinatura do escritório no Asaas (AD-230). Sem a chave, "Pagar" responde indisponível; sem o
# token, todo webhook é recusado. Dev/teste: https://api-sandbox.asaas.com/v3 e a chave do sandbox.
# O token é o mesmo cadastrado no webhook do painel do Asaas (header asaas-access-token).
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Volta da fatura paga ao Ethica (URL do web). Só depois de cadastrar o domínio em Minha Conta >
# Informações no Asaas: sem isso o Asaas recusa toda cobrança que traz o retorno.
ASAAS_RETURN_URL=

# Caixa que recebe as mensagens da página Contato (AD-249). Vazia = o formulário responde indisponível.
CONTACT_EMAIL=

# web (Vite só expõe variáveis prefixadas VITE_ ao client.api.ts)
VITE_API_URL=http://localhost:18080

# MailProvider — "log" escreve no log estruturado em vez de enviar (dev/test);
# "resend" envia pela API HTTPS do Resend (produção, AD-219); "nodemailer" envia por SMTP.
# MAIL_FROM é o remetente de qualquer provedor (não existe SMTP_FROM); no SMTP do Zoho tem de ser o próprio SMTP_USER.
# Provedor real sem as variáveis dele não sobe, em qualquer ambiente (AD-222):
#   resend → RESEND_API_KEY + MAIL_FROM   ·   nodemailer → SMTP_HOST (+ PORT/USER/PASS) + MAIL_FROM
MAIL_PROVIDER=log
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
