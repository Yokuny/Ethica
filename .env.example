# Ambiente
NODE_ENV=development

# MongoDB Atlas Local (docker compose up -d mongo, porta 37017). Os testes usam o banco
# `<banco>_test` deste mesmo servidor, derivado daqui (RUN_BOOK.md#banco-de-dados).
MONGODB_URI=mongodb://localhost:37017/ethica?directConnection=true

# api
API_PORT=18080
SESSION_JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:15173

# Datajud — API Pública do CNJ (prospecção de nomeações). A chave pública vigente
# está na documentação oficial: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# PDF (AD-119) — Chromium do sistema; no docker já é este caminho.
CHROMIUM_PATH=/usr/bin/chromium

# Arquivos do tenant (AD-120) — RustFS (S3) do docker compose (porta 19000). No container da api o
# endpoint é sobrescrito para http://s3:9000. Sem S3_BUCKET o envio de logo fica desligado.
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=ethica
S3_ACCESS_KEY_ID=ethica
S3_SECRET_ACCESS_KEY=ethica-dev-secret

# web (Vite só expõe variáveis prefixadas VITE_ ao client.api.ts)
VITE_API_URL=http://localhost:18080

# MailProvider — "log" escreve no log estruturado em vez de enviar (dev/test)
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
