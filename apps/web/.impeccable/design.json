    {
      "name": "Botão de ação",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal grafite da tela.",
      "html": "<button class=\"ds-button-primary\">Adicionar</button>",
      "css": ".ds-button-primary{height:32px;padding:0 10px;border:0;border-radius:8px;background:var(--primary,#1d1c20);color:#fff;font:500 13px \"Geist Variable\",sans-serif;cursor:pointer;transition:background .15s ease-out}.ds-button-primary:hover{background:var(--primary-hover,#38373d)}.ds-button-primary:focus-visible{outline:2px solid var(--ring,#4b4b54);outline-offset:2px}"
    },
    {
      "name": "Item da sidebar",
      "kind": "nav",
      "refersTo": "sidebar-item-active",
      "description": "Seleção da navegação sobre o fundo pastel.",
      "html": "<div class=\"ds-sidebar\"><div class=\"ds-sidebar-item\">Clientes</div></div>",
      "css": ".ds-sidebar{padding:8px;background:var(--sidebar,#f1f1f3);font:500 13px \"Geist Variable\",sans-serif;color:var(--foreground,#4b4b54)}.ds-sidebar-item{height:32px;display:flex;align-items:center;padding:0 8px;border-radius:8px;background:var(--sidebar-accent,#e8e7ec);color:var(--impact,#1d1c1f)}"
    },
    {
      "name": "Painel de trabalho",
      "kind": "card",
      "refersTo": "content-inset",
      "description": "Canvas claro recuado da sidebar.",
      "html": "<div class=\"ds-inset\"><div class=\"ds-inset-heading\">Clientes</div><div class=\"ds-inset-rule\"></div></div>",
      "css": ".ds-inset{min-height:100px;padding:16px;border:1px solid var(--border,#e5e4e8);border-radius:18px;background:var(--background,#f7f7f7);box-shadow:0 1px 2px rgb(29 28 32 / .04);font:400 13px \"Geist Variable\",sans-serif;color:var(--foreground,#4b4b54)}.ds-inset-heading{font-size:18px;font-weight:600;color:var(--impact,#1d1c1f)}.ds-inset-rule{height:1px;margin-top:12px;background:var(--border,#e5e4e8)}"
    },
    {
      "name": "Campo de busca",
      "kind": "input",
      "refersTo": "input",
      "description": "Busca compacta sobre o canvas.",
      "html": "<input class=\"ds-input\" placeholder=\"Buscar…\" />",
      "css": ".ds-input{height:32px;width:240px;padding:0 10px;border:1px solid var(--input,#d8d7dd);border-radius:8px;background:var(--background,#f7f7f7);box-shadow:0 1px 2px rgb(29 28 32 / .04);font:400 13px \"Geist Variable\",sans-serif;color:var(--foreground,#4b4b54)}.ds-input::placeholder{color:var(--text-secondary,#66656f)}.ds-input:hover{border-color:#a6a5af}.ds-input:focus-visible{outline:2px solid var(--ring,#4b4b54);outline-offset:1px}"
    },
    {
      "name": "Cabeçalho de tabela",
      "kind": "custom",
      "refersTo": "table-header",
      "description": "Rótulos compactos em mono sobre fio fino.",
      "html": "<div class=\"ds-table-head\"><span>NOME</span><span>STATUS</span></div>",
      "css": ".ds-table-head{display:flex;justify-content:space-between;align-items:center;height:40px;padding:0 16px;border-bottom:1px solid var(--border,#e5e4e8);font:500 10px \"Geist Mono\",monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--text-secondary,#66656f)}"
    },
    {
      "name": "Estado ativo",
      "kind": "chip",
      "description": "Selo pastel para um status operacional.",
      "html": "<span class=\"ds-status\">Ativo</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:4px;background:var(--status-success,#dcefdc);color:var(--status-success-foreground,#245b38);font:500 12px \"Geist Variable\",sans-serif}"
    }
  ],
  "narrative": {
    "northStar": "Mesa de trabalho serena",
    "overview": "O Ethica é usado durante sessões longas. A sidebar forma o fundo da aplicação, enquanto o trabalho acontece em uma superfície clara recuada. Dados, filtros e ações ficam perto uns dos outros; bordas finas e pequenas diferenças de tom estabelecem a hierarquia.",
    "keyCharacteristics": [
      "Um único tema claro",
      "Ação grafite",
      "Sidebar pastel atrás do painel",
      "Linhas compactas",
      "Captions mono",
      "Sombra com deslocamento mínimo",
      "Indicadores apenas quando apoiados por dados reais"
    ],
    "rules": [
      {
        "name": "Contraste da informação",
        "body": "#9594a0 serve apenas a pistas não essenciais; texto pequeno necessário à tarefa usa #66656f.",
        "section": "colors"
      },
      {
        "name": "Identidade no primitivo",
        "body": "Cor, fonte, borda, raio e sombra pertencem aos tokens e componentes base, não a cada rota.",
        "section": "components"
      },
      {
        "name": "Métrica verdadeira",
        "body": "Indicadores e gráficos só entram quando a consulta oferece os dados necessários.",
        "section": "components"
      }
    ],
    "dos": [
      "Defina identidade em apps/web/src/theme.css e nos primitivos; a rota compõe dados e layout local.",
      "Use ItemDescription caption para rótulos descritivos e texto secundário legível para informação essencial.",
      "Confira 1440px e 390px, hover, ativo, seleção, foco, loading, erro e vazio.",
      "Preserve consultas, permissões, URLs e comportamento das ações ao redesenhar uma tela."
    ],
    "donts": [
      "Não reintroduza troca de paleta ou modo escuro nesta direção de tema claro único.",
      "Não invente companhia, cargo, cidade, gráficos, KPIs temporais ou ações em lote para copiar a imagem.",
      "Não use azul como acento genérico; as cores semânticas de status são a exceção.",
      "Não use #9594a0 para texto pequeno que precisa ser lido, nem mono para todo o corpo.",
      "Não espalhe borda, sombra e fonte de identidade pelas rotas."
    ]
  }
}
